                        <TextView android:id="@+id/tvValueOmzet5" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="2dp" android:gravity="center" android:textColor="@color/primary_dark_green" android:textSize="7sp" android:textStyle="bold"/>
