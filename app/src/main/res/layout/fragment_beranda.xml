                        android:baselineAligned="false">
                        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
                        <TextView android:id="@+id/tvValue6" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="2dp" android:gravity="center" android:textColor="@color/primary_dark_green" android:textSize="8sp" android:textStyle="bold"/>
                        <View android:id="@+id/bar6" android:layout_width="match_parent" android:layout_height="20dp" android:background="@color/primary_dark_green"/>
                        <TextView android:id="@+id/tvMonth6" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="Jun" android:textColor="@color/text_secondary" android:textSize="9sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="1dp"
                        android:orientation="vertical"
                        android:baselineAligned="false">
                        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
                        <TextView android:id="@+id/tvValue7" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="2dp" android:gravity="center" android:textColor="@color/primary_dark_green" android:textSize="8sp" android:textStyle="bold"/>
                        <View android:id="@+id/bar7" android:layout_width="match_parent" android:layout_height="20dp" android:background="@color/primary_dark_green"/>
                        <TextView android:id="@+id/tvMonth7" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="Jul" android:textColor="@color/text_secondary" android:textSize="9sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="1dp"
                        android:orientation="vertical"
                        android:baselineAligned="false">
                        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
                        <TextView android:id="@+id/tvValue8" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="2dp" android:gravity="center" android:textColor="@color/primary_dark_green" android:textSize="8sp" android:textStyle="bold"/>
