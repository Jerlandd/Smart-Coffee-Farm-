                    android:layout_height="wrap_content"
                    android:text="Omzet Bulanan"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Bar Chart 12 Months Omzet -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:weightSum="12">

                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="1dp" android:orientation="vertical" android:baselineAligned="false">
                        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
                        <TextView android:id="@+id/tvValueOmzet1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="2dp" android:gravity="center" android:textColor="@color/primary_dark_green" android:textSize="7sp" android:textStyle="bold"/>
                        <View android:id="@+id/barOmzet1" android:layout_width="match_parent" android:layout_height="20dp" android:background="@color/primary_dark_green"/>
