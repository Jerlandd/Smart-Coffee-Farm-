                        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
                        <TextView android:id="@+id/tvValue5" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="2dp" android:gravity="center" android:textColor="@color/primary_dark_green" android:textSize="8sp" android:textStyle="bold"/>
