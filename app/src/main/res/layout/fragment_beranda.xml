                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Baik"
                        android:textColor="@color/primary_dark_green"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

